CLEAR_DAY_ADDR=:8080
CLEAR_DAY_API_TOKEN=replace-with-a-long-random-secret

# Local development store. Use the dev table for dummy data.
CLEAR_DAY_STORE=dynamodb
CLEAR_DAY_DYNAMODB_TABLE=clearday-reminders-dev
AWS_REGION=ap-southeast-1
CLEAR_DAY_STATIC_DIR=../../frontend

# Offline local fallback if you do not want to use AWS.
# CLEAR_DAY_STORE=json
# CLEAR_DAY_JSON_PATH=../data/reminders.json

# AWS production store.
# CLEAR_DAY_STORE=dynamodb
# CLEAR_DAY_DYNAMODB_TABLE=clearday-reminders
# AWS_REGION=ap-southeast-1
