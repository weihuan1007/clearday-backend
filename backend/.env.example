CLEAR_DAY_ADDR=:8080
# Local-only fallback. Production should use the Cognito settings below.
CLEAR_DAY_API_TOKEN=replace-with-a-long-random-secret
# Local convenience only. This lets the browser read the token from /config.js
# so you do not get the token popup every time during development.
CLEAR_DAY_EXPOSE_API_TOKEN=true

# Production login. Set all five values together and remove the static token.
# CLEAR_DAY_COGNITO_USER_POOL_ID=ap-southeast-1_example
# CLEAR_DAY_COGNITO_CLIENT_ID=exampleclientid
# CLEAR_DAY_COGNITO_DOMAIN=https://example.auth.ap-southeast-1.amazoncognito.com
# CLEAR_DAY_COGNITO_REDIRECT_URI=https://example.cloudfront.net/
# CLEAR_DAY_COGNITO_LOGOUT_URI=https://example.cloudfront.net/

# Local development store. Use the dev table for dummy data.
CLEAR_DAY_STORE=dynamodb
CLEAR_DAY_DYNAMODB_TABLE=clearday-reminders-dev
AWS_REGION=ap-southeast-1
AWS_PROFILE=clearday-dev
CLEAR_DAY_STATIC_DIR=../../frontend

# Offline local fallback if you do not want to use AWS.
# CLEAR_DAY_STORE=json
# CLEAR_DAY_JSON_PATH=../data/reminders.json

# AWS production store.
# CLEAR_DAY_STORE=dynamodb
# CLEAR_DAY_DYNAMODB_TABLE=clearday-reminders
# Optional Money tab table. Use Cognito or a private key from openssl rand -hex 32.
# CLEAR_DAY_MONEY_TABLE=clearday-money-transactions
# CLEAR_DAY_MONEY_TOKEN=
# AWS_REGION=ap-southeast-1
